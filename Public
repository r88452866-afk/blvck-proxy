
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#000000">
  <title>BLVCK</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #050505;
      color: #fff;
      font-family: system-ui, sans-serif;
    }
    main { width: min(90%, 540px); text-align: center; }
    h1 { letter-spacing: .28em; font-size: 2.8rem; }
    input, button {
      padding: 14px; border-radius: 12px;
      border: 1px solid #333; background: #111;
      color: white; font-size: 1rem;
    }
    input { width: 100%; margin: 16px 0 10px; }
    button { cursor: pointer; }
    p { color: #999; font-size: .9rem; }
  </style>
</head>
<body>
  <main>
    <h1>BLVCK</h1>
    <form id="search">
      <input id="url" placeholder="Enter a website URL…" autocomplete="url">
      <button type="submit">Open</button>
    </form>
    <p>Minimal. Focused. BLVCK.</p>
    <p id="status"></p>
  </main>
  <script>
    document.querySelector("#search").addEventListener("submit", event => {
      event.preventDefault();
      const value = document.querySelector("#url").value.trim();
      if (!value) return;
      document.querySelector("#status").textContent =
        "Proxy browsing isn't enabled on the server yet.";
    });
  </script>
</body>
</html>
